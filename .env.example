# Copy to .env (`cp .env.example .env`). .env is git-ignored; this file is tracked.
# The values below are non-secret defaults for LOCAL DEVELOPMENT ONLY. Never reuse them anywhere
# else. GOOGLE_API_KEY is the only real secret; leave it empty until you need it.

# Read by the app but not used or validated yet.
GOOGLE_API_KEY=

# Postgres container settings (docker-compose.yml)
POSTGRES_USER=rbaa
POSTGRES_PASSWORD=rbaa_local_dev
POSTGRES_DB=rbaa

# Connection URLs used by the app inside the Compose network (hosts are service names).
# Keep the credentials in DATABASE_URL in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://rbaa:rbaa_local_dev@postgres:5432/rbaa
REDIS_URL=redis://redis:6379/0

# Host port the app is published on.
APP_PORT=8000
